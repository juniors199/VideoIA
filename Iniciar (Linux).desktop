[Desktop Entry]
Version=1.0
Type=Application
Name=Iniciar Ilustrando Studio
Comment=Instala o que faltar e abre o estudio no navegador
Terminal=true
Categories=AudioVideo;Video;
# %k = caminho deste .desktop; a pasta do estudio e a mesma pasta
Exec=bash -c "cd \"$(dirname \"$1\")\" && exec bash \"./Iniciar (Linux).sh\"" -- %k
Icon=applications-multimedia